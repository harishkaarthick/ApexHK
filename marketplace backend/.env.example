# ==========================================
# Marketplace Backend Environment Variables
# ==========================================

# MongoDB
MONGODB_URI=mongodb://localhost:27017/marketplace

# JWT
# Use a strong random secret in your actual .env
JWT_SECRET=
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_CORS_REQUIRE_EXPLICIT_CONFIG=false

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
# Use placeholder TEST keys for local development; never commit real credentials.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Mail
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=ApexHK

# Redis
# Prefer REDIS_URL for Render Key Value internal URLs.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REQUIRE_EXPLICIT_CONFIG=false
