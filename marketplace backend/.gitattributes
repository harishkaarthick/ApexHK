# L-1: Normalise all line endings to LF on commit.
# Prevents diff noise from mixed CRLF/LF across service, DTO, and config files.
* text=auto eol=lf
*.java text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.sh text eol=lf eol=lf
mvnw text eol=lf
mvnw.cmd text eol=crlf
